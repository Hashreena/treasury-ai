# Treasury AI — Environment Variables (EXAMPLE / TEMPLATE)
# -----------------------------------------------------------------
# Copy this file to ".env" and replace the placeholder values, OR
# set these variables directly in your terminal before running.
#
# The app runs WITHOUT these — AI features fall back to a
# deterministic offline mode. Set them to enable live AI.
# -----------------------------------------------------------------

# Your Chutes AI API key (keep this secret — never commit the real key)
CHUTES_API_KEY=your_chutes_api_key_here

# Chutes AI endpoint (not secret — use this value as-is)
CHUTES_API_URL=https://llm.chutes.ai/v1/chat/completions

# The AI model to use (not secret — use this value as-is)
CHUTES_MODEL=deepseek-ai/DeepSeek-V3.2-TEE
